# Copy this file to .env and fill in your own values.
# NEVER commit the .env file.

# --- PostgreSQL ---
POSTGRES_DB=somatelliebherr
DB_USERNAME=postgres
DB_PASSWORD=change_me

# JDBC URL used by the backend (Docker Compose overrides it to point to the "db" service)
DB_URL=jdbc:postgresql://localhost:5432/somatelliebherr

# --- Security ---
# HMAC-SHA256 key, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRATION=86400000

# --- File storage (GED uploads) ---
FILE_UPLOAD_DIR=./uploads
